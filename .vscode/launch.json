{
	"_comment": "Use this file to configure the graphrag project for debugging. You may create other configuration profiles based on these or select one below to use.",
	"version": "0.2.0",
	"env": {
        "PATH": "/Users/asafatzmon/dev/graphrag/.venv/bin:${env:PATH}"
    },
	"configurations": [
		{
			"name": "Initializer",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "init",
				"--root", "../awel-dealership/"
			],
		},
		{
			"name": "Indexer",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "index",
				"--root", "../awel-dealership/"
			],
		},
		{
			"name": "Loader",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "load",
				"--root", "../awel-dealership/",
				"--load-communities"
			],
		},
		{
			"name": "Query",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "query",
				"--root", "../awel-dealership/",
				"--method", "local",
				"--query", "Find data on our Janurary vehicles sales at Cleveland: Historical monthly sales for the past six months,competitor pricing on similar models,a local market trend indicator for luxury cars, and a brief overview of top complaints or negative feedback from our customers",
			]
		},
		{
			"name": "Prompt Tuning",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "prompt_tune",
				"--root", "../awel-dealership/",
				"--output", "../awel-dealership/prompts/",
				"--config",
				"../awel-dealership/settings.yaml",
				"--no-discover-entity-types"
			]
		}
	]
}