{
	"_comment": "Use this file to configure the graphrag project for debugging. You may create other configuration profiles based on these or select one below to use.",
	"version": "0.2.0",
	"env": {
        "PATH": "/Users/asafatzmon/dev/graphrag/.venv/bin:${env:PATH}"
    },
	"configurations": [
		{
			"name": "Initializer",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "init",
				"--root", "../500songs-batch1/"
			],
		},
		{
			"name": "Indexer",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "index",
				"--root", "../500songs-batch1/"
			],
		},
		{
			"name": "Loader",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "load",
				"--root", "../500songs-batch1/"
			],
		},
		{
			"name": "Query",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "query",
				"--root", "../500songs-batch1/",
				"--method", "local",
				"--query", "What is Paint it Black and what impact did it have?",
				"--response-type", "two statements"
			]
		},
		{
			"name": "Prompt Tuning",
			"type": "debugpy",
			"request": "launch",
			"module": "poetry",
			"args": [
				"poe", "prompt_tune",
				"--root", "../500songs-batch1/",
				"--output", "../500songs-batch1/prompts/",
				"--config",
				"../500songs-batch1/settings.yaml",
				"--no-discover-entity-types"
			]
		}
	]
}